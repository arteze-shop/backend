# Local env values
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:8000/
DASHBOARD_URL=http://localhost:9000/
CACHE_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1
DATABASE_URL=postgres://saleor:saleor@db/saleor
DEFAULT_FROM_EMAIL=noreply@domain.com
EMAIL_URL=smtp://
SECRET_KEY=changeme
OTEL_SERVICE_NAME=saleor
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- In production these would look like below ---

# ALLOWED_HOSTS=api.domain.com,api,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://admin.domain.com,https://domain.com
# PUBLIC_URL=https://api.domain.com/
# DASHBOARD_URL=https://admin.domain.com/

# --- Database ---
# IMPORTANT: Don't use a pooled connection string for DATABASE_URL 
# as they are uncompatible with django cursors
# DATABASE_URL=postgresql://

# CACHE_URL=redis://cache:6379/0
# CELERY_BROKER_URL=redis://cache:6379/1

# Remove or comment out Jaeger if not using it
# OTEL_SERVICE_NAME=saleor
# OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Cloudflare R2 (S3-Compatible Storage) ---
# AWS_ACCESS_KEY_ID=cloudflare_access_key_id
# AWS_SECRET_ACCESS_KEY=cloudflare_secret_access_key
# AWS_MEDIA_BUCKET_NAME=clouflare_bucket_name
# AWS_STORAGE_BUCKET_NAME=clouflare_bucket_name
# AWS_MEDIA_CUSTOM_DOMAIN=clouflare_media_custom_domain # eg. media.domain.com
# AWS_S3_ENDPOINT_URL=cloudflare_s3_endpoint_url

# Security
# SECRET_KEY=secret_key # IMPORTANT: Generate a strong key.

# Email (Will be configured via the SMTP App UI, setting defaults just in case)
# DEFAULT_FROM_EMAIL=noreply@domain.com
# EMAIL_URL=smtp://user:pass@brevo_smtp:587/?ssl=False&tls=True # This will be overridden by SMTP App

# RSA_PRIVATE_KEY="rsa_private_key" # in quotes, should be in a single line, add \n for new lines
